{
  "input_dir": "/app/data",
  "output_dir": "/app/output",
  "temp_dir": "/tmp/skald-image",
  "weights": "app/sensitive_data_masking/license_plate_detector.pt",
  "device": "cpu",
  "mask_mode": "black",
  "ocr": false,
  "ocr_langs": "en",
  "conf": 0.1,
  "imgsz": 640,
  "high_thresh": 500.0,
  "low_thresh": 100.0,
  "ext": "jpg,jpeg,png,bmp,tif,tiff,webp",
  "exif_strip": true,
  "watermark_removal": true,
  "human_mask": true,
  "plate_mask": true,
  "resizing": true
}
