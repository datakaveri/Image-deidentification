# Image De-identification environment configuration.
# Copy to .env and fill in for your deployment. Every variable is optional; the
# Docker image already sets the container values shown in the comments.

# --- Pipeline paths (read by image_deidentification.main) ---------------------
# Used as defaults when the config file does not set input_dir/output_dir/temp_dir.
# Local defaults: train/images, outputs/final, outputs/temp. Container: /app/data,
# /app/output, /tmp/skald-image.
SKALD_DATA_DIR=
SKALD_OUTPUT_DIR=
# Intermediate images may be only partly redacted: keep this inside the container,
# never on a volume that leaves the enclave.
SKALD_TEMP_DIR=
# Config mount point (container: /app/config). Documents the TEE layout; the code
# reads the config path from --config.
SKALD_CONFIG_DIR=

# --- Model download (read by scripts/download_models.py) -----------------------
# Override where the plate detector and optional yolov8n weights are fetched from.
# SHA-256 is still verified. Defaults point at GitHub Releases.
PLATE_MODEL_URL=
YOLOV8N_URL=

# --- Model caches (read by the ML libraries) ----------------------------------
# Container: /opt/easyocr, /opt/torch, /opt/ultralytics, /tmp/matplotlib.
EASYOCR_MODULE_PATH=
TORCH_HOME=
YOLO_CONFIG_DIR=
MPLCONFIGDIR=
