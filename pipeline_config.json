{
  "input_dir": "app/sensitive_data_masking/img",
  "output_dir": "app/output/img_output",
  "temp_dir": "app/output/temp_img",
  "weights": "app/sensitive_data_masking/license_plate_detector.pt",
  "device": "auto",
  "ext": "jpg,jpeg,png,bmp,tif,tiff,webp",
  "exif_strip": true,
  "watermark_removal": true,
  "human_mask": true,
  "human_mask_mode": "blur",
  "human_blur_kernel": 15551,
  "human_dilation_size": 91,
  "plate_mask": true,
  "mask_mode": "black",
  "ocr": false,
  "ocr_langs": "en",
  "conf": 0.1,
  "imgsz": 640,
  "resizing": false,
  "high_thresh": 500.0,
  "low_thresh": 100.0,
  "workers": 1,
  "max_gpu_workers": 1,
  "worker_start_method": "spawn",
  "log_file": ""
}
